{
  "name": "meshkeep",
  "version": "0.0.0",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "tsup>esbuild": "0.28.1"
    }
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "smoke:artifacts": "node scripts/smoke-artifacts.mjs",
    "check": "biome check . && pnpm typecheck && pnpm test && pnpm build && pnpm smoke:artifacts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "22.20.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
