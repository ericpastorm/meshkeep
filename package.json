{
  "name": "meshkeep",
  "version": "0.1.0-dev",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "tsup>esbuild": "0.28.1"
    }
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck && tsc --project tests/tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && pnpm typecheck && pnpm test && pnpm build && node packages/cli/dist/bin.js version"
  },
  "devDependencies": {
    "@meshkeep/cli": "workspace:*",
    "@meshkeep/kubo": "workspace:*",
    "@biomejs/biome": "2.3.11",
    "@types/node": "22.20.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
