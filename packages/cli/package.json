{
  "name": "@meshkeep/cli",
  "version": "0.0.0",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "meshkeep": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@meshkeep/protocol": "workspace:*",
    "commander": "14.0.2"
  }
}
