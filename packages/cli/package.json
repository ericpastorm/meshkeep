{
  "name": "@meshkeep/cli",
  "version": "0.1.0-dev",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "meshkeep": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@meshkeep/kubo": "workspace:*",
    "@meshkeep/protocol": "workspace:*",
    "commander": "14.0.2"
  }
}
