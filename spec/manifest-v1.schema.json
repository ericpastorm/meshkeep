{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshkeep.dev/spec/manifest-v1.schema.json",
  "$comment": "Initial draft. Signature semantics will be decided by an ADR.",
  "title": "Meshkeep Deployment Manifest v1",
  "description": "Initial unsigned manifest for a Meshkeep site deployment.",
  "type": "object",
  "required": [
    "schema",
    "siteId",
    "sequence",
    "contentCid",
    "previousManifestCid",
    "createdAt",
    "unixfsProfile",
    "stats"
  ],
  "properties": {
    "schema": {
      "const": "https://meshkeep.dev/spec/manifest-v1.schema.json"
    },
    "siteId": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "contentCid": {
      "type": "string",
      "minLength": 1
    },
    "previousManifestCid": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "unixfsProfile": {
      "const": "unixfs-v1-2025"
    },
    "stats": {
      "type": "object",
      "required": ["files", "bytes"],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
